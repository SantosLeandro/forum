{% extends "./base.html.twig" %}

{% block title %}Editar post{% endblock %}
{% block head %}
    {{ parent() }}
{% endblock %}
{% block body %}
    <a href="/">Home </a> > <a href="/forum/{{ post.getTopic.getForum.getId }}"> {{ post.getTopic.getForum.getTitle }} </a> > <a href="/topic/{{ post.getTopic.getId }}"> {{ post.getTopic.getTitle }} </a>
    <div class="rounded-border">
        <h3>Editar post</h3>
        <form class="form" action="/post.update" method="POST">
            <input type="hidden" name="token" value="{{ csrf_token('post.update') }}"/>
            <input type="hidden" name="post_id" value="{{ post.getId }}"/>
            <textarea id="text" name="content" cols="30" rows="10">{{ bbcode }}</textarea>
            <input type="submit" value="Salvar">
        </form>
    </div>
{% endblock %}