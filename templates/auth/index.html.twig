{% extends "./base.html.twig" %}

{% block title %}Entrar{% endblock %}
{% block head %}
    {{ parent() }}
{% endblock %}
{% block body %}
    <div class="auth-page">
        <div class="form-panel form-panel-auth">
            <div class="form-panel-header">
                <i class='bx bxs-log-in'></i> Entrar
            </div>
            <div class="form-panel-body">
                {% if message is defined and message %}
                    <div class="form-errors">
                        <p>{{ message }}</p>
                    </div>
                {% endif %}
                {% if error %}
                    <div class="form-errors">
                        <p>{{ error.messageKey|trans(error.messageData, 'security') }}</p>
                    </div>
                {% endif %}
                <form class="form form-create-acc" action="/login" method="POST">
                    <input type="hidden" name="token" value="{{ csrf_token('login') }}"/>
                    <div>
                        <label class="form-label" for="_username">
                            <i class='bx bxs-envelope'></i> E-mail
                        </label>
                        <input id="_username" type="email" name="_username"
                               placeholder="exemplo@email.com"
                               value="{{ last_username is defined ? last_username : '' }}"
                               autocomplete="username" required autofocus>
                    </div>
                    <div>
                        <label class="form-label" for="_password">
                            <i class='bx bxs-lock-alt'></i> Senha
                        </label>
                        <input id="_password" type="password" name="_password"
                               placeholder="Digite sua senha"
                               autocomplete="current-password" required>
                    </div>
                    <div>
                        <input type="submit" value="Entrar">
                    </div>
                </form>
                <div class="auth-switch">
                    Não tem conta? <a class="link" href="/user.create">Criar conta</a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}