{% extends "./base.html.twig" %}

{% block title %}Criar conta{% endblock %}
{% block head %}
    {{ parent() }}
{% endblock %}
{% block body %}
    <div class="auth-page">
        <div class="form-panel form-panel-auth">
            <div class="form-panel-header">
                <i class='bx bxs-user-plus'></i> Criar Conta
            </div>
            <div class="form-panel-body">
                {% if message is defined and message %}
                    <div class="form-errors">
                        <p>{{ message }}</p>
                    </div>
                {% endif %}
                {% if messages is defined %}
                    <div class="form-errors">
                        {% for msg in messages %}
                            <p>{{ msg }}</p>
                        {% endfor %}
                    </div>
                {% endif %}
                <form class="form form-create-acc" action="/users" method="POST">
                    <input type="hidden" name="token" value="{{ csrf_token('user.store') }}"/>
                    <div>
                        <label class="form-label" for="username">
                            <i class='bx bxs-user'></i> Nome de usuário
                        </label>
                        <input id="username" type="text" name="username"
                               placeholder="Escolha um nome de usuário"
                               value="{{ username is defined ? username : '' }}"
                               autocomplete="username" required>
                    </div>
                    <div>
                        <label class="form-label" for="email">
                            <i class='bx bxs-envelope'></i> E-mail
                        </label>
                        <input id="email" type="email" name="email"
                               placeholder="exemplo@email.com"
                               value="{{ email is defined ? email : '' }}"
                               autocomplete="email" required>
                    </div>
                    <div>
                        <label class="form-label" for="password">
                            <i class='bx bxs-lock-alt'></i> Senha
                        </label>
                        <input id="password" type="password" name="password"
                               placeholder="Mínimo de 8 caracteres"
                               autocomplete="new-password" required>
                    </div>
                    <div>
                        <label class="form-label" for="password-confirmation">
                            <i class='bx bxs-lock-alt'></i> Confirme a senha
                        </label>
                        <input id="password-confirmation" type="password" name="password_confirmation"
                               placeholder="Digite a senha novamente"
                               autocomplete="new-password" required>
                        <span id="password-hint" class="form-hint"></span>
                    </div>
                    <div>
                        <span class="form-label"> Avatar </span>
                        <div class="avatar-list" id="avatar-list">
                            {% for avatar in avatars %}
                                <label class="avatar-option">
                                    <input name="avatar" type="radio" value="{{ avatar.name }}" {% if selected_avatar is defined and avatar.name == selected_avatar %}checked{% endif %}>
                                    <img src="{{ url }}{{ avatar.name }}" alt="{{ avatar.name }}">
                                </label>
                            {% endfor %}
                        </div>
                    </div>
                    <div>
                        <input type="submit" value="Criar conta">
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endblock %}